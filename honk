#!/usr/bin/env bash
# Honk — independent third-party fuzzy launcher for goose sessions.
#
# Usage:
#   honk                     interactive picker
#   honk -r <fragment>       resolve fragment → resume (no picker)
#   honk --list              pretty text table
#   honk --json              newline-delimited JSON
#   honk --working-dir DIR   restrict picker to a directory subtree
#   honk -w DIR              short form of --working-dir
#   honk --all               don't filter by cwd
#   honk --no-cwd            don't filter by cwd (alias for --all)
#   honk --archived          include archived sessions
#   honk --limit N           (default: 50)
#   honk --provider NAME     override provider for this run
#   honk --model NAME        override model for this run
#   honk --version           print honk version and exit
#   honk --help
#
# See README.md for action keybindings inside the picker.

set -euo pipefail

# Resolve project root regardless of where honk was invoked from.
HONK_ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export HONK_ROOT
HONK_LIB="$HONK_ROOT/lib"

# shellcheck disable=SC1091
source "$HONK_LIB/list.sh"
# shellcheck disable=SC1091
source "$HONK_LIB/preview.sh"
# shellcheck disable=SC1091
source "$HONK_LIB/actions.sh"

HONK_LIMIT_DEFAULT=50

# Resolve the version string. Prefer `git describe` when the checkout is
# a git working tree so development builds self-identify; otherwise fall
# back to the baked-in release tag.
HONK_VERSION="0.2.0"
if command -v git >/dev/null 2>&1 && [[ -d "$HONK_ROOT/.git" ]]; then
    if v=$(git -C "$HONK_ROOT" describe --always --dirty 2>/dev/null) && [[ -n "$v" ]]; then
        HONK_VERSION="$v"
    fi
fi
export HONK_VERSION

usage() {
    cat <<'EOF'
Honk — independent third-party fuzzy launcher for goose sessions

USAGE
  honk                      Interactive picker (default)
  honk -r <fragment>        Resolve fragment against id/name/path and resume
  honk --list               Pretty text list of recent sessions
  honk --json               Newline-delimited JSON, one object per session
  honk --working-dir DIR    Restrict picker to sessions in DIR (default: $PWD)
  honk -w DIR               Short form of --working-dir
  honk --all                Don't filter by cwd
  honk --no-cwd             Don't filter by cwd (alias for --all)
  honk --archived           Include archived sessions
  honk --limit N            Limit results (default: 50)
  honk --provider NAME      Override provider for the next launch
  honk --model NAME         Override model for the next launch
  honk --version            Print honk version and exit
  honk -V                   Short form of --version
  honk --help               Show this help
  honk -h                   Short form of --help

PICKER KEY BINDINGS
  Enter         Resume selected session (cd to its working_dir)
  Ctrl-F        Fork (resume with --fork)
  Ctrl-N        Start a new session in the selected session's dir
  Ctrl-E        Export session JSON to ./
  Ctrl-D        Delete (asks for y/N confirmation)
  Ctrl-A        Show all sessions; press again to return to cwd-only
  Ctrl-P        Pick provider/model for the next launch (mirrors the
                desktop app's per-session model selector)
  Esc / Ctrl-C  Cancel

EXAMPLES
  honk
  honk --working-dir ~/projects/foo
  HONK_LIMIT=200 honk --all
  honk --provider anthropic --model claude-3-5-sonnet-latest    # next launch uses this provider/model
  honk -r CI    # fuzzy-resolve and resume a session matching 'CI'

ENVIRONMENT
  HONK_LIMIT            Default limit (overridden by --limit)
  HONK_ARCHIVED=1       Include archived sessions
  HONK_PWD_ONLY=0       Don't filter by cwd
  HONK_WORKDIR=DIR      Override cwd filter base
  HONK_PROVIDER=NAME    Override provider for the next launch
  HONK_MODEL=NAME       Override model for the next launch
EOF
}

# Non-interactive resume by fragment.
# Rank: exact id > exact name > prefix name > substring. Falls back to fzf if
# ambiguous (>1 strong match).
honk_resolve_fragment() {
    local query="$1"
    local matches id picked
    matches=$(honk_list_json | jq -r --arg q "$query" '
        . as $s
        | ($s.id // "") as $id
        | ($s.name // "") as $name
        | ($s.working_dir // "") as $wd
        | (if   $id   == $q then 0
           elif $name == $q then 1
           elif $name | startswith($q) then 2
           elif ($name | ascii_downcase) | contains($q | ascii_downcase) then 3
           elif $wd   | contains($q) then 4
           else null end) as $rank
        | select($rank != null)
        | ([$rank, .id, .name // "", .working_dir // ""] | @tsv)
    ' | sort -n)

    local count
    count=$(printf '%s' "$matches" | grep -c . || true)
    case "$count" in
        0)  echo "honk: no session matches '$query'" >&2; return 1 ;;
        1)  ;; # exactly one
        *)  # multiple — show fzf to disambiguate, then resume the pick.
            # Test for an interactive terminal (-t 1 + -t 2) the same way
            # honk_pick does. -t 0 (stdin) is the wrong check: piping
            # stdin but rendering on a tty is a perfectly valid picker
            # invocation, and a tty stdin with non-tty stdout (e.g.
            # `honk -r demo | less`) is not.
            if [[ -t 1 && -t 2 ]]; then
                picked=$(printf '%s\n' "$matches" | cut -f2- \
                    | fzf --prompt="multiple matches for '$query' > ") || return 0
                id=$(printf '%s' "$picked" | cut -f1)
                if [[ -z "$id" ]]; then
                    return 0
                fi
                honk_action_resume "$id"
                return $?
            else
                echo "honk: '$query' matches multiple sessions and no tty for picker:" >&2
                printf '%s\n' "$matches" | cut -f2- >&2
                return 2
            fi
            ;;
    esac
    id=$(printf '%s' "$matches" | cut -f2)
    honk_action_resume "$id"
}

# Render the picker (the main interactive flow).
#
# Guarded against non-tty invocation: fzf with `--expect` and no controlling
# tty blocks forever waiting for the user to press one of the expected keys.
# Detect that up-front and route to non-interactive forms so scripts, CI, and
# accidental `honk </dev/null` runs don't hang the user's shell.
honk_pick() {
    local workdir="${HONK_WORKDIR:-$PWD}"
    local pwd_only="${HONK_PWD_ONLY:-1}"
    local limit="${HONK_LIMIT:-$HONK_LIMIT_DEFAULT}"
    local archived="${HONK_ARCHIVED:-0}"

    export HONK_LIMIT="$limit" HONK_PWD_ONLY="$pwd_only" HONK_WORKDIR="$workdir" HONK_ARCHIVED="$archived"

    if ! command -v fzf >/dev/null 2>&1; then
        echo "honk: fzf is required for the interactive picker" >&2
        return 1
    fi

    # Require a tty before doing any work. Without it, fzf --expect blocks on
    # stdin forever, and a goose query here would only produce a misleading
    # error when goose is also missing.
    if [[ ! -t 1 || ! -t 2 ]]; then
        echo "honk: the interactive picker needs a tty." >&2
        echo "    For non-interactive use, try one of:" >&2
        echo "      honk --list              # pretty text listing" >&2
        echo "      honk --json              # newline-delimited JSON" >&2
        echo "      honk -r <fragment>       # fuzzy-resolve & resume" >&2
        return 1
    fi

    # Snapshot the session list once. The picker builds rows from this
    # call, the recent-directories strip uses it again, the pickdir action
    # uses it again, and the fzf preview pane (which runs on every cursor
    # move and keypress) reads from it too. One goose roundtrip + one jq
    # filter is enough.
    local cache
    cache=$(mktemp "${TMPDIR:-/tmp}/honk.XXXXXX.json")
    # Don't export HONK_LIST_CACHE yet — honk_list_json short-circuits to
    # the cache file whenever the env var is set and the file is readable,
    # so exporting now would make the initial fetch read the empty mktemp
    # file (which is readable but zero-length), skip the goose roundtrip,
    # and leave the cache — and therefore the entire picker — empty.
    # Clean up on shell exit. The resume/fork/new actions exec into goose
    # so the cache is leaked in that path, but only one tempfile per
    # picker invocation — `/tmp` reapers tolerate that.
    #
    # HONK_PICK_CACHE_DEBUG_DIR is a test/debug hook: when set, the cache
    # is also copied to <dir>/honk-pick-cache.json before being removed,
    # so tests can inspect what the picker produced without patching the
    # trap line via sed. Leaving it unset in production means no
    # measurable overhead.
    trap 'if [[ -n "${HONK_PICK_CACHE_DEBUG_DIR:-}" && -n "${HONK_LIST_CACHE:-}" && -r "${HONK_LIST_CACHE}" ]]; then
            cp "${HONK_LIST_CACHE}" "${HONK_PICK_CACHE_DEBUG_DIR}/honk-pick-cache.json" 2>/dev/null || true
        fi
        rm -f "${HONK_LIST_CACHE:-}"' EXIT
    if ! honk_list_json > "$cache"; then
        rm -f "$cache"
        echo "honk: failed to fetch session list" >&2
        return 1
    fi
    # Now that the cache is populated, publish it so the row builder, the
    # recent-directories strip, fzf's preview pane (which fires on every
    # keystroke), and the action helpers all share one goose session list
    # roundtrip instead of re-querying goose on every tick.
    export HONK_LIST_CACHE="$cache"

    # Compose the picker rows. Format per row:
    #   <display>\t<id-or-marker>\t<…unused trailing…>
    # Col 1 is what fzf displays and searches (via --with-nth=1); the shared
    # row builder includes the id there in dim text so it stays searchable.
    # Col 2 is the machine-readable key we route actions on; that's also what
    # the preview pane passes to lib/preview.sh via the {2} token.
    #
    # Layout (top-down, oldest last):
    #   [synthetic]   ▶  New session here  (cwd)            ← bright, top-of-list
    #   [real sessions, newest first]                         ← the meat
    #   [synthetic]   ▶  New session at…  (pick a directory)  ← dim
    #   [synthetic]   → recent project dirs                  ← dim, indented
    local fmt_rows
    fmt_rows=$(honk_picker_rows)

    # Preview pane gets the session id from column 2 of the input line.
    local preview_cmd="bash '$HONK_LIB/preview.sh' {2}"

    # Ctrl-A toggles between the cwd-only and all-sessions views. We
    # deliberately do not use fzf's become(...) here: the child become
    # process inherits this picker's piped stdout (the $(...) substitution),
    # so re-invoking honk in the opposite mode would trip its own tty guard.
    # Instead ctrl-a is in --expect below; fzf exits with that key and we exec
    # a fresh honk from the same terminal fds.

    # fzf must stay in the foreground process group of the terminal, or the
    # kernel stops it with SIGTTIN the instant it reads /dev/tty (a frozen
    # picker). GNU timeout(1) runs commands in their own background group by
    # default, so pass --foreground; if the installed timeout lacks it, run
    # fzf without a wrapper (Esc / Ctrl-C still cancel cleanly). Used for
    # both the main picker and the Ctrl-P sub-pickers, so the timeout is
    # factored into honk_fzf below.
    honk_fzf() {
        local -a tmo=()
        if command -v timeout >/dev/null 2>&1 \
            && timeout --help 2>&1 | grep -q -- '--foreground'; then
            tmo=(timeout --foreground "${HONK_FZF_TIMEOUT:-600}")
        fi
        "${tmo[@]}" fzf "$@"
    }

    # Dynamic prompt: when the user has set a provider/model override
    # (via Ctrl-P, --provider/--model CLI, or HONK_PROVIDER/HONK_MODEL
    # env), reflect it in the prompt so it's visible before pressing
    # Enter. Mirrors the desktop app's persistent model indicator.
    local prompt="goose"
    if [[ -n "${HONK_PROVIDER:-}" && -n "${HONK_MODEL:-}" ]]; then
        prompt="goose [$HONK_PROVIDER/$HONK_MODEL]"
    elif [[ -n "${HONK_PROVIDER:-}" ]]; then
        prompt="goose [$HONK_PROVIDER]"
    fi

    local selection
    selection=$(
        honk_fzf --ansi \
            --delimiter=$'\t' \
            --with-nth=1 \
            --prompt="${prompt} › " \
            --no-sort \
            --no-multi \
            --height=85% \
            --layout=reverse \
            --border \
            --preview="$preview_cmd" \
            --preview-window='right:45%:wrap:border-sharp' \
            --header='enter resume · ^F fork · ^N new · ^E export · ^D delete · ^A all · ^P provider/model' \
            --expect='enter,ctrl-a,ctrl-f,ctrl-n,ctrl-e,ctrl-d,ctrl-p' \
            --print-query \
            ${query_arg:+--query "$query_arg"} \
        <<<"$fmt_rows"
    ) || {
        local rc=$?
        # 124 == timeout(1) SIGKILL exit code → user-idle timeout fired.
        if (( rc == 124 )); then
            echo "honk: picker timed out after ${HONK_FZF_TIMEOUT:-600}s" >&2
        fi
        return 0
    }

    # With --print-query and --expect, fzf emits three lines:
    #   <query>          ← the user's search box (may be empty)
    #   <key>            ← "enter", "ctrl-a", … or "esc"/"ctrl-c" when cancelled
    #   <selected line>  ← the row the user highlighted (TAB-separated columns)
    # Read all three. An empty key (Esc/Ctrl-C) means the user cancelled.
    local last_query key raw_line
    { read -r last_query && read -r key && read -r raw_line; } <<<"$selection" || return 0
    [[ -z "$key" || -z "$raw_line" ]] && return 0
    local j
    j=$(printf '%s\n' "$raw_line" | awk -F'\t' '{print $2}')
    [[ -z "$j" ]] && { echo "honk: empty id from selection; aborting" >&2; return 1; }

    case "$key" in
        enter)
            case "$j" in
                __NEW_HERE__)
                    honk_action_new "$PWD"
                    ;;
                __PICK_DIR__)
                    # Offer a quick picker over the recent working_dirs of
                    # past sessions. Plain list — pipe through fzf.
                    # `// ""` keeps sessions without a working_dir from
                    # surfacing as a literal "null" entry in the picker.
                    local target
                    target=$(honk_list_json | jq -r '.working_dir // ""' | awk '!seen[$0]++' \
                             | fzf --prompt='pick a directory for a new session › ' \
                                  --height=50% --layout=reverse --border) || return 0
                    [[ -n "$target" ]] && honk_action_new "$target"
                    ;;
                __NEW_AT__*)
                    honk_action_new "${j#__NEW_AT__}"
                    ;;
                *)
                    honk_action_resume "$j"
                    ;;
            esac
            ;;
        ctrl-a)
            # Reopen the picker in the opposite filter mode. exec so honk
            # is replaced; carry over the result cap, working directory,
            # and any provider/model override (which is otherwise lost
            # when we exec a fresh honk process).
            local reopen=( --limit "$limit" )
            if [[ -n "${HONK_WORKDIR:-}" ]]; then
                reopen+=( --working-dir "$HONK_WORKDIR" )
            fi
            if (( pwd_only == 1 )); then
                reopen+=( --all )
            fi
            if [[ -n "${HONK_PROVIDER:-}" ]]; then
                reopen+=( --provider "$HONK_PROVIDER" )
            fi
            if [[ -n "${HONK_MODEL:-}" ]]; then
                reopen+=( --model "$HONK_MODEL" )
            fi
            [[ -n "$last_query" ]] && reopen+=( --query "$last_query" )
            exec "$(readlink -f "$0")" "${reopen[@]}"
            ;;
        ctrl-p)
            # Per-session provider/model selector. Mirrors the Goose
            # Desktop app's model dropdown: pick a provider from the
            # candidates derived from the cached session list (plus a
            # small fallback for discoverability), then a model from
            # the cached models for that provider. If the chosen
            # provider has no recorded models in this session history
            # we skip the model sub-picker and let goose use its
            # default model for that provider — goose handles that
            # lookup natively, so honk doesn't need to enumerate it.
            #
            # The override is applied via exec-reopen so the prompt
            # visibly reflects it. Cursor position is lost across the
            # reopen, but the user's search query is preserved (read
            # from fzf's --print-query output above).
            local new_provider new_model
            if ! new_provider=$(honk_provider_candidates \
                | honk_fzf --prompt='provider › ' \
                           --no-sort --height=60% --layout=reverse --border \
                           --header="current: ${HONK_PROVIDER:-(default)} | Esc to keep") ; then
                return 0   # Esc on the sub-picker: keep the current override
            fi
            new_provider="${new_provider% (current)}"

            local model_candidates
            model_candidates=$(honk_model_candidates "$new_provider")
            if [[ -z "$model_candidates" ]]; then
                printf 'honk: no recorded models for provider %q in session history; goose will use its default model\n' \
                    "$new_provider" >&2
                new_model=""
            elif ! new_model=$(printf '%s\n' "$model_candidates" \
                | honk_fzf --prompt="model for $new_provider › " \
                           --no-sort --height=60% --layout=reverse --border \
                           --header="provider: $new_provider | current: ${HONK_MODEL:-(default)} | Esc to use default") ; then
                # Esc on the model sub-picker: keep the provider override
                # but fall back to goose's default model for it.
                new_model=""
            else
                new_model="${new_model% (current)}"
            fi

            local reopen=( --limit "$limit" )
            [[ -n "${HONK_WORKDIR:-}" ]] && reopen+=( --working-dir "$HONK_WORKDIR" )
            (( pwd_only == 0 )) && reopen+=( --all )
            reopen+=( --provider "$new_provider" )
            [[ -n "$new_model" ]] && reopen+=( --model "$new_model" )
            [[ -n "$last_query" ]] && reopen+=( --query "$last_query" )
            exec "$(readlink -f "$0")" "${reopen[@]}"
            ;;
        ctrl-f)
            [[ "$j" == __NEW_HERE__ || "$j" == __PICK_DIR__ || "$j" == __NEW_AT__* ]] && {
                echo "honk: nothing to fork for a synthetic row" >&2; return 0; }
            honk_action_fork "$j"
            ;;
        ctrl-n)
            local target_dir="$PWD"
            case "$j" in
                __NEW_HERE__)         target_dir="$PWD" ;;
                __NEW_AT__*)          target_dir="${j#__NEW_AT__}" ;;
                __PICK_DIR__)         # Picker row has no own dir; fall back
                                        # to $PWD. Enter on this row opens
                                        # the directory picker instead.
                                        target_dir="$PWD" ;;
                *)                    target_dir=$(honk_session_working_dir "$j")
                                        [[ -z "$target_dir" ]] && target_dir="$PWD" ;;
            esac
            honk_action_new "$target_dir"
            ;;
        ctrl-e)
            [[ "$j" == __NEW_HERE__ || "$j" == __PICK_DIR__ || "$j" == __NEW_AT__* ]] && {
                echo "honk: nothing to export for a synthetic row" >&2; return 0; }
            honk_action_export "$j" "./${j}.json"
            ;;
        ctrl-d)
            [[ "$j" == __NEW_HERE__ || "$j" == __PICK_DIR__ || "$j" == __NEW_AT__* ]] && {
                echo "honk: nothing to delete for a synthetic row" >&2; return 0; }
            honk_action_delete "$j"
            ;;
        *)
            case "$j" in
                __NEW_HERE__|__PICK_DIR__|__NEW_AT__*) ;;        # no-op for synthetic rows
                *)                       honk_action_resume "$j" || true ;;
            esac
            ;;
    esac
}

# ---- argument parsing ----
mode="pick"
query=""
list=0
json=0
help=0
version=0
limit="${HONK_LIMIT:-$HONK_LIMIT_DEFAULT}"
workdir="${HONK_WORKDIR:-}"
cwd_only="${HONK_PWD_ONLY:-1}"
archived="${HONK_ARCHIVED:-0}"
provider="${HONK_PROVIDER:-}"
model="${HONK_MODEL:-}"
query_arg=""

while (($#)); do
    case "$1" in
        -h|--help)        help=1 ;;
        -h=*|--help=*)    help=1 ;;   # ignore =value; flag is boolean
        -V|--version)     version=1 ;;
        -V=*|--version=*) version=1 ;;   # ignore =value; flag is boolean
        -l|--list)        list=1 ;;
        -l=*|--list=*)    list=1 ;;   # ignore =value; flag is boolean
        --json)           json=1 ;;
        --json=*)         json=1 ;;   # ignore =value; flag is boolean
        -r|--resume)      mode="resolve"; shift; query="${1:-}"; [[ -z "$query" ]] && { echo "honk: -r needs an argument" >&2; exit 2; } ;;
        -r=*)             mode="resolve"; query="${1#*=}"; [[ -z "$query" ]] && { echo "honk: -r needs an argument" >&2; exit 2; } ;;
        --resume=*)       mode="resolve"; query="${1#*=}"; [[ -z "$query" ]] && { echo "honk: --resume needs an argument" >&2; exit 2; } ;;
        --working-dir)    shift; workdir="${1:-}"; [[ -z "$workdir" ]] && { echo "honk: --working-dir needs an argument" >&2; exit 2; } ;;
        --working-dir=*)  workdir="${1#*=}"; [[ -z "$workdir" ]] && { echo "honk: --working-dir needs an argument" >&2; exit 2; } ;;
        -w)               shift; workdir="${1:-}"; [[ -z "$workdir" ]] && { echo "honk: -w needs an argument" >&2; exit 2; } ;;
        -w=*)             workdir="${1#*=}"; [[ -z "$workdir" ]] && { echo "honk: -w needs an argument" >&2; exit 2; } ;;
        --all)            cwd_only=0 ;;
        --all=*)          cwd_only=0 ;;   # ignore =value; flag is boolean
        --archived)       archived=1 ;;
        --archived=*)     archived=1 ;;   # ignore =value; flag is boolean
        --limit)          shift; limit="${1:-}"; [[ -z "$limit" ]] && { echo "honk: --limit needs an argument" >&2; exit 2; } ;;
        --limit=*)        limit="${1#*=}"; [[ -z "$limit" ]] && { echo "honk: --limit needs an argument" >&2; exit 2; } ;;
        --provider)       shift; provider="${1:-}"; [[ -z "$provider" ]] && { echo "honk: --provider needs an argument" >&2; exit 2; } ;;
        --provider=*)     provider="${1#*=}"; [[ -z "$provider" ]] && { echo "honk: --provider needs an argument" >&2; exit 2; } ;;
        --model)          shift; model="${1:-}"; [[ -z "$model" ]] && { echo "honk: --model needs an argument" >&2; exit 2; } ;;
        --model=*)        model="${1#*=}"; [[ -z "$model" ]] && { echo "honk: --model needs an argument" >&2; exit 2; } ;;
        --query)          shift; query_arg="${1:-}"; ;;   # initial fzf query (used to restore on reopen)
        --query=*)        query_arg="${1#*=}"; ;;
        --no-cwd)         cwd_only=0 ;;
        --no-cwd=*)       cwd_only=0 ;;   # ignore =value; flag is boolean
        --)               shift; break ;;
        -*)               echo "honk: unknown flag: $1" >&2; exit 2 ;;
        *)                # treat as resume query if standalone
                           if [[ -n "$query" ]]; then
                               echo "honk: unexpected extra argument: $1" >&2
                               exit 2
                           fi
                           mode="resolve"; query="$1" ;;
    esac
    shift || true
done

if ! [[ "$limit" =~ ^[1-9][0-9]*$ ]]; then
    echo "honk: --limit must be a positive integer" >&2
    exit 2
fi
if [[ "$cwd_only" != 0 && "$cwd_only" != 1 ]]; then
    echo "honk: HONK_PWD_ONLY must be 0 or 1" >&2
    exit 2
fi
if [[ "$archived" != 0 && "$archived" != 1 ]]; then
    echo "honk: HONK_ARCHIVED must be 0 or 1" >&2
    exit 2
fi
export HONK_LIMIT="$limit"
export HONK_PWD_ONLY="$cwd_only"
export HONK_ARCHIVED="$archived"
export HONK_WORKDIR="$workdir"
export HONK_PROVIDER="$provider"
export HONK_MODEL="$model"

if (( help )); then
    usage
    exit 0
fi

if (( version )); then
    printf 'honk %s\n' "$HONK_VERSION"
    exit 0
fi

if (( list )); then
    honk_list_pretty
    exit 0
fi

if (( json )); then
    honk_list_json
    exit 0
fi

case "$mode" in
    resolve)
        [[ -z "$query" ]] && { echo "honk: nothing to resolve" >&2; exit 2; }
        honk_resolve_fragment "$query"
        ;;
    pick)
        honk_pick
        ;;
esac
